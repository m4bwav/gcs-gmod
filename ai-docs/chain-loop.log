[0], a[1]), (x0, b[0], b[1]), (x1, b[0], b[1])], n, tex)\n    return \"solid\\\\n{\\\\n\\\\t\\\\\"id\\\\\" \\\\\"%d\\\\\"\\\\n%s}\\\\n\" % (nid(), s)\n\n\ndef yprism''','''        s += side([(x0, a[0], a[1]), (x0, b[0], b[1]), (x1, b[0], b[1])], n, tex, (uvs or {}).get(i))\n    return \"solid\\\\n{\\\\n\\\\t\\\\\"id\\\\\" \\\\\"%d\\\\\"\\\\n%s}\\\\n\" % (nid(), s)\n\n\ndef yprism''')\ns=s.replace('''    N = 20\n    for i in range(N):\n        a0, a1 = math.pi*i/N, math.pi*(i+1)/N\n        r0, r1 = 0, WALL\n        p = lambda r, a: (round((HY+r)*math.cos(a)), round(SPRING + (VRISE+r)*math.sin(a)))\n        poly = [p(r1, a0), p(r1, a1), p(r0, a1), p(r0, a0)]\n        W(xprism(poly, -HX, HX, TEX_VAULT))''','''    # The inner faces carry the zodiac mural (2048x1024) once: u along x, v along the arc.\n    N = 20\n    r0, r1 = 0, WALL\n    p = lambda r, a: (round((HY+r)*math.cos(a)), round(SPRING + (VRISE+r)*math.sin(a)))\n    arc = [p(r0, math.pi*i/N) for i in range(N+1)]\n    seg = [math.dist(arc[i], arc[i+1]) for i in range(N)]\n    su, sv = 2*HX/2048, sum(seg)/1024\n    s0 = 0\n    for i in range(N):\n        a0, a1 = math.pi*i/N, math.pi*(i+1)/N\n        poly = [p(r1, a0), p(r1, a1), p(r0, a1), p(r0, a0)]\n        q0, q1 = arc[i], arc[i+1]\n        ty, tz = (q1[0]-q0[0])/seg[i], (q1[1]-q0[1])/seg[i]\n        uv = (\"[1 0 0 %g] %g\" % (HX/su, su),\n              \"[0 %g %g %g] %g\" % (ty, tz, (s0 - (q0[0]*ty + q0[1]*tz))/sv, sv))\n        W(xprism(poly, -HX, HX, TEX_VAULT, {2: uv}))\n        s0 += seg[i]''')\nopen(p,'w').write(s)\nEOF\ngrep -n \"uvs or\" tools/build_vmf.py; sed -i 's#gcs/vault_sky#gcs/vault_mural#' src/materials/gcs/vault.vmt","description":"Enlarge figures, map mural onto vault faces"}}],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,